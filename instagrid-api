const express = require('express');
const sqlite3 = require('sqlite3').verbose();
const bcrypt = require('bcrypt');
const { randomUUID } = require('crypto');
const cors = require('cors');
const path = require('path');

const app = express();
const port = Number(process.env.PORT) || 3000;
const db = new sqlite3.Database(
  process.env.DB_PATH || path.join(__dirname, 'instagrid.db')
);

app.use(cors());
app.use(express.json({ limit: '1mb' }));

class HttpError extends Error {
  constructor(status, message) {
    super(message);
    this.status = status;
  }
}

const run = (sql, params = []) => new Promise((resolve, reject) => {
  db.run(sql, params, function (err) {
    if (err) return reject(err);
    resolve({ lastID: this.lastID, changes: this.changes });
  });
});

const get = (sql, params = []) => new Promise((resolve, reject) => {
  db.get(sql, params, (err, row) => {
    if (err) return reject(err);
    resolve(row);
  });
});

const all = (sql, params = []) => new Promise((resolve, reject) => {
  db.all(sql, params, (err, rows) => {
    if (err) return reject(err);
    resolve(rows);
  });
});

const asyncRoute = (handler) => (req, res, next) => {
  Promise.resolve(handler(req, res, next)).catch(next);
};

const requireAuth = asyncRoute(async (req, res, next) => {
  const authorization = req.get('authorization') || '';
  const match = authorization.match(/^Bearer ([\da-f-]{36})$/i);
  if (!match) throw new HttpError(401, 'Authentication required.');

  const user = await get(
    `SELECT users.id, users.username
     FROM sessions
     JOIN users ON users.id = sessions.user_id
     WHERE sessions.token = ?`,
    [match[1]]
  );
  if (!user) throw new HttpError(401, 'Invalid or expired session.');
  req.user = user;
  next();
});

const parsePostId = (value) => {
  const id = Number(value);
  if (!Number.isSafeInteger(id) || id < 1) {
    throw new HttpError(400, 'Invalid post ID.');
  }
  return id;
};

const postListSql = `
  SELECT posts.id, posts.user_id AS userId, users.username,
         posts.image_url AS imageUrl, posts.caption, posts.created_at AS createdAt,
         (SELECT COUNT(*) FROM likes WHERE likes.post_id = posts.id) AS likeCount,
         (SELECT COUNT(*) FROM comments WHERE comments.post_id = posts.id) AS commentCount
  FROM posts
  JOIN users ON users.id = posts.user_id
`;

async function initializeDatabase() {
  await run('PRAGMA foreign_keys = ON');
  await run(`CREATE TABLE IF NOT EXISTS users (
    id TEXT PRIMARY KEY,
    username TEXT NOT NULL UNIQUE COLLATE NOCASE,
    password_hash TEXT NOT NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`);
  await run(`CREATE TABLE IF NOT EXISTS sessions (
    token TEXT PRIMARY KEY,
    user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`);
  await run(`CREATE TABLE IF NOT EXISTS posts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    image_url TEXT NOT NULL,
    caption TEXT NOT NULL DEFAULT '',
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`);
  await run(`CREATE TABLE IF NOT EXISTS follows (
    follower_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    followed_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (follower_id, followed_id),
    CHECK (follower_id != followed_id)
  )`);
  await run(`CREATE TABLE IF NOT EXISTS likes (
    user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    post_id INTEGER NOT NULL REFERENCES posts(id) ON DELETE CASCADE,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (user_id, post_id)
  )`);
  await run(`CREATE TABLE IF NOT EXISTS comments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    post_id INTEGER NOT NULL REFERENCES posts(id) ON DELETE CASCADE,
    body TEXT NOT NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`);
}

app.get('/', (req, res) => {
  res.status(200).json({ name: 'Instagrid API', status: 'ok' });
});

app.post('/api/signup', asyncRoute(async (req, res) => {
  const { username, password } = req.body || {};
  if (typeof username !== 'string' || typeof password !== 'string') {
    throw new HttpError(400, 'Username and password are required.');
  }

  const normalizedUsername = username.trim();
  if (!/^[\w.-]{3,30}$/.test(normalizedUsername)) {
    throw new HttpError(400, 'Username must be 3–30 characters (letters, numbers, _, . or -).');
  }
  if (Buffer.byteLength(password, 'utf8') < 8 || Buffer.byteLength(password, 'utf8') > 72) {
    throw new HttpError(400, 'Password must be between 8 and 72 bytes.');
  }

  const passwordHash = await bcrypt.hash(password, 10);
  const userId = randomUUID();
  try {
    await run(
      'INSERT INTO users (id, username, password_hash) VALUES (?, ?, ?)',
      [userId, normalizedUsername, passwordHash]
    );
  } catch (error) {
    if (error.message.includes('UNIQUE constraint failed: users.username')) {
      throw new HttpError(409, 'Username already exists.');
    }
    throw error;
  }

  const token = randomUUID();
  await run('INSERT INTO sessions (token, user_id) VALUES (?, ?)', [token, userId]);
  res.status(201).json({ userId, username: normalizedUsername, token });
}));

app.post('/api/login', asyncRoute(async (req, res) => {
  const { username, password } = req.body || {};
  if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
    throw new HttpError(400, 'Username and password are required.');
  }

  const user = await get('SELECT id, username, password_hash FROM users WHERE username = ?', [username.trim()]);
  if (!user || !(await bcrypt.compare(password, user.password_hash))) {
    throw new HttpError(401, 'Invalid username or password.');
  }

  const token = randomUUID();
  await run('INSERT INTO sessions (token, user_id) VALUES (?, ?)', [token, user.id]);
  res.status(200).json({ userId: user.id, username: user.username, token });
}));

app.post('/api/logout', requireAuth, asyncRoute(async (req, res) => {
  const token = req.get('authorization').slice('Bearer '.length);
  await run('DELETE FROM sessions WHERE token = ?', [token]);
  res.status(204).end();
}));

app.get('/api/me', requireAuth, (req, res) => {
  res.json(req.user);
});

app.get('/api/users/:username', asyncRoute(async (req, res) => {
  const user = await get(
    `SELECT id, username, created_at AS createdAt,
       (SELECT COUNT(*) FROM posts WHERE posts.user_id = users.id) AS postCount,
       (SELECT COUNT(*) FROM follows WHERE follows.followed_id = users.id) AS followerCount,
       (SELECT COUNT(*) FROM follows WHERE follows.follower_id = users.id) AS followingCount
     FROM users WHERE username = ?`,
    [req.params.username]
  );
  if (!user) throw new HttpError(404, 'User not found.');
  res.json(user);
}));

app.get('/api/users/:username/posts', asyncRoute(async (req, res) => {
  const user = await get('SELECT id FROM users WHERE username = ?', [req.params.username]);
  if (!user) throw new HttpError(404, 'User not found.');
  const posts = await all(`${postListSql} WHERE posts.user_id = ? ORDER BY posts.id DESC LIMIT 50`, [user.id]);
  res.json(posts);
}));

app.post('/api/posts', requireAuth, asyncRoute(async (req, res) => {
  const { imageUrl, caption = '' } = req.body || {};
  if (typeof imageUrl !== 'string' || typeof caption !== 'string') {
    throw new HttpError(400, 'An image URL and a text caption are required.');
  }
  let parsedUrl;
  try {
    parsedUrl = new URL(imageUrl);
  } catch {
    throw new HttpError(400, 'Image URL must be a valid HTTP or HTTPS URL.');
  }
  if (!['http:', 'https:'].includes(parsedUrl.protocol) || imageUrl.length > 2048) {
    throw new HttpError(400, 'Image URL must be a valid HTTP or HTTPS URL.');
  }
  if (caption.length > 2200) throw new HttpError(400, 'Caption must be 2200 characters or fewer.');

  const result = await run(
    'INSERT INTO posts (user_id, image_url, caption) VALUES (?, ?, ?)',
    [req.user.id, imageUrl, caption.trim()]
  );
  const post = await get(`${postListSql} WHERE posts.id = ?`, [result.lastID]);
  res.status(201).json(post);
}));

app.get('/api/feed', requireAuth, asyncRoute(async (req, res) => {
  const posts = await all(
    `${postListSql}
     WHERE posts.user_id = ? OR posts.user_id IN (
       SELECT followed_id FROM follows WHERE follower_id = ?
     )
     ORDER BY posts.id DESC LIMIT 50`,
    [req.user.id, req.user.id]
  );
  res.json(posts);
}));

app.delete('/api/posts/:postId', requireAuth, asyncRoute(async (req, res) => {
  const result = await run('DELETE FROM posts WHERE id = ? AND user_id = ?', [
    parsePostId(req.params.postId),
    req.user.id
  ]);
  if (!result.changes) throw new HttpError(404, 'Post not found.');
  res.status(204).end();
}));

app.post('/api/posts/:postId/like', requireAuth, asyncRoute(async (req, res) => {
  const postId = parsePostId(req.params.postId);
  const post = await get('SELECT id FROM posts WHERE id = ?', [postId]);
  if (!post) throw new HttpError(404, 'Post not found.');
  await run('INSERT OR IGNORE INTO likes (user_id, post_id) VALUES (?, ?)', [req.user.id, postId]);
  res.status(204).end();
}));

app.delete('/api/posts/:postId/like', requireAuth, asyncRoute(async (req, res) => {
  await run('DELETE FROM likes WHERE user_id = ? AND post_id = ?', [
    req.user.id,
    parsePostId(req.params.postId)
  ]);
  res.status(204).end();
}));

app.get('/api/posts/:postId/comments', asyncRoute(async (req, res) => {
  const postId = parsePostId(req.params.postId);
  const post = await get('SELECT id FROM posts WHERE id = ?', [postId]);
  if (!post) throw new HttpError(404, 'Post not found.');
  const comments = await all(
    `SELECT comments.id, comments.post_id AS postId, comments.body,
            comments.created_at AS createdAt, users.id AS userId, users.username
     FROM comments JOIN users ON users.id = comments.user_id
     WHERE comments.post_id = ? ORDER BY comments.id ASC`,
    [postId]
  );
  res.json(comments);
}));

app.post('/api/posts/:postId/comments', requireAuth, asyncRoute(async (req, res) => {
  const postId = parsePostId(req.params.postId);
  const body = req.body && req.body.body;
  if (typeof body !== 'string' || !body.trim() || body.trim().length > 2000) {
    throw new HttpError(400, 'Comment must be between 1 and 2000 characters.');
  }
  const post = await get('SELECT id FROM posts WHERE id = ?', [postId]);
  if (!post) throw new HttpError(404, 'Post not found.');

  const result = await run(
    'INSERT INTO comments (user_id, post_id, body) VALUES (?, ?, ?)',
    [req.user.id, postId, body.trim()]
  );
  const comment = await get(
    `SELECT comments.id, comments.post_id AS postId, comments.body,
            comments.created_at AS createdAt, users.id AS userId, users.username
     FROM comments JOIN users ON users.id = comments.user_id
     WHERE comments.id = ?`,
    [result.lastID]
  );
  res.status(201).json(comment);
}));

app.post('/api/users/:userId/follow', requireAuth, asyncRoute(async (req, res) => {
  if (req.params.userId === req.user.id) throw new HttpError(400, 'You cannot follow yourself.');
  const target = await get('SELECT id FROM users WHERE id = ?', [req.params.userId]);
  if (!target) throw new HttpError(404, 'User not found.');
  await run(
    'INSERT OR IGNORE INTO follows (follower_id, followed_id) VALUES (?, ?)',
    [req.user.id, target.id]
  );
  res.status(204).end();
}));

app.delete('/api/users/:userId/follow', requireAuth, asyncRoute(async (req, res) => {
  await run('DELETE FROM follows WHERE follower_id = ? AND followed_id = ?', [
    req.user.id,
    req.params.userId
  ]);
  res.status(204).end();
}));

app.use((err, req, res, next) => {
  if (res.headersSent) return next(err);
  if (err instanceof HttpError) {
    return res.status(err.status).json({ error: err.message });
  }
  if (err instanceof SyntaxError && err.status === 400 && 'body' in err) {
    return res.status(400).json({ error: 'Invalid JSON body.' });
  }
  console.error(err);
  res.status(500).json({ error: 'Internal server error.' });
});

initializeDatabase()
  .then(() => {
    app.listen(port, () => {
      console.log(`Instagrid API is running on http://localhost:${port}`);
    });
  })
  .catch((error) => {
    console.error('Failed to initialize the database:', error);
    process.exitCode = 1;
  });
